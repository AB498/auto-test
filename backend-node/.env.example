PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=orderdesk
DB_USERNAME=orderdesk
DB_PASSWORD=secret

# Database used by `npm test` (created by docker/mysql-init.sql).
DB_TEST_DATABASE=orderdesk_test

# Set to "true" to log every SQL query.
DB_LOGGING=false

# Simulated MySQL write failures on order_events (see src/faults/faultInjector.js).
# One of: deadlock_once, table_full. Can also be sent per request with an X-Simulate-Fault header.
FAULT_ORDER_EVENTS=
